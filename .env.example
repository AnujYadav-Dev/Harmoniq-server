# harmoniq-server configuration. Copy to `.env` (the setup script does this for you).
# Every variable is documented in docs/deployment.md §5. Commented lines show the defaults.

# --- Core -----------------------------------------------------------------------------------------
# The secret built into the Harmoniq APK. Format: id:secret[,id2:secret2] (two only while rotating).
APP_TOKENS=app-v1:sk.......
# HOST=0.0.0.0
# PORT=8000
# APP_ENV=production            # "development" enables /docs and auto-reload
# LOG_LEVEL=INFO
# PUBLIC_BASE_URL=              # e.g. https://harmoniq.example.com (informational)
# DATA_DIR=./data
# TOOLS_DIR=./tools             # where ffmpeg, ffprobe and deno live; empty = use PATH

# --- Limits ---------------------------------------------------------------------------------------
# MAX_CONCURRENT_DOWNLOADS=2
# QUEUE_MAX_DEPTH=20
# MAX_ACTIVE_JOBS_PER_DEVICE=3
# RATE_LIMIT_SEARCH_PER_MIN=30
# RATE_LIMIT_DOWNLOADS_PER_HOUR=60
# RATE_LIMIT_GLOBAL_PER_MIN=120
# MAX_DURATION_SECONDS=900
# JOB_TIMEOUT_SECONDS=600
# YT_MIN_INTERVAL_SECONDS=2

# --- Caching and storage --------------------------------------------------------------------------
# SEARCH_CACHE_TTL=21600
# METADATA_CACHE_TTL=3600
# JOB_TTL_SECONDS=86400
# FILE_TTL_SECONDS=86400
# STORAGE_MAX_BYTES=5368709120
# DISK_MIN_FREE_BYTES=1073741824

# --- Audio ----------------------------------------------------------------------------------------
# DEFAULT_FORMAT=m4a            # m4a | opus | mp3
# MP3_STANDARD_BITRATE=192k
# ARTWORK_MAX_PX=1200

# --- YouTube access -------------------------------------------------------------------------------
# YTDLP_JS_RUNTIME=deno         # deno | node | bun | quickjs
# POT_PROVIDER_URL=             # e.g. http://pot-provider:4416 (Docker) or http://127.0.0.1:4416
# YTDLP_COOKIES_FILE=           # e.g. secrets/cookies.txt (throwaway account only!)
# YTDLP_PROXY=                  # e.g. socks5://warp:1080 or socks5://user:pass@host:port (yt-dlp only)
# YTDLP_IP_VERSION=auto         # auto (retry over IPv6 on bot-check) | 6 | 4
# YTDLP_SLEEP_REQUESTS=0.5
# CANARY_VIDEO_ID=              # a stable Creative Commons video, tested hourly (e.g. jNQXAC9IVRw)

# --- Metadata (docs/server-implementation-plan.md) -------------------------------------------------
# METADATA_PROVIDERS=ytmusic,youtube,musicbrainz,lastfm,lyrics
# LYRICS_PROVIDERS=ytmusic,lrclib
# MUSICBRAINZ_CONTACT=          # optional contact for the MusicBrainz User-Agent (URL or email)
# LASTFM_API_KEY=               # optional genre fallback
# METADATA_TIMEOUT_SECONDS=25
# MAX_PLAYLIST_TRACKS=200        # tracks returned by /v1/playlists/{id}
# SEARCH_ALL_SECTION_LIMIT=10    # results per section for /v1/search?type=all
# FILENAME_TEMPLATE={artist} - {title}

# --- Alert email -----------------------------------------------------------------------------------
# Emails ALERT_EMAIL_TO when 3 downloads are blocked by YouTube within 30 minutes. All four must be set. Gmail needs an
# App Password (no spaces), not the normal password. Test it with: python -m app.alerts
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# ALERT_EMAIL_TO=

# --- Docker only ----------------------------------------------------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN=      # for `docker compose --profile tunnel up -d`
# HARMONIQ_UID=1000             # Linux hosts: owner of ./data
# HARMONIQ_GID=1000
